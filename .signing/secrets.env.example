# Copy to `.signing/secrets.env` and fill in. NEVER commit the filled-in file
# (it is gitignored). These are also the values that become GitHub Actions
# secrets for the release workflow (Sprint B6 / DC28). Placeholders only here.

# ─── macOS: Developer ID signing + notarization ───────────────────────────────
# Your Apple Developer Team ID (10 chars).
APPLE_TEAM_ID="XXXXXXXXXX"
# Exact signing identity string from the certificate.
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (XXXXXXXXXX)"
# Password used when you exported macos/developer_id_application.p12.
APPLE_CERTIFICATE_PASSWORD="change-me"
# App Store Connect API key for notarization (preferred over Apple ID/password).
APPLE_API_KEY_ID="XXXXXXXXXX"
APPLE_API_ISSUER_ID="00000000-0000-0000-0000-000000000000"
# Path to the .p8 (kept in .signing/macos/). Used locally; in CI the key is a secret.
APPLE_API_KEY_PATH=".signing/macos/AuthKey_XXXXXXXXXX.p8"

# For CI, Tauri reads the certificate as base64. Generate with:
#   base64 -i .signing/macos/developer_id_application.p12 | pbcopy   (macOS)
#   base64 -w0 .signing/macos/developer_id_application.p12           (Linux)
# then store the output as the GitHub secret APPLE_CERTIFICATE (do NOT put it here).

# ─── Windows: Azure Artifact Signing (chosen path) ───────────────────────────
# (Renamed from "Trusted Signing" in Jan 2026 — same service, same endpoints.)
WINDOWS_CERT_METHOD="azure-trusted-signing"
# Artifact Signing account (as created in the Azure portal) and its certificate
# profile. The account name is the "Artifact Signing Account" resource name.
TRUSTED_SIGNING_ACCOUNT_NAME="Synaplan"
TRUSTED_SIGNING_CERT_PROFILE_NAME="synaplan-desktop"
# Region endpoint of the account (pick the one matching your account's region):
#   West Europe  -> https://weu.codesigning.azure.net
#   North Europe -> https://neu.codesigning.azure.net
#   East US      -> https://eus.codesigning.azure.net
TRUSTED_SIGNING_ENDPOINT="https://weu.codesigning.azure.net"
# Service principal that CI uses to sign. Assign it the role
# "Artifact Signing Certificate Profile Signer" (old name: "Trusted Signing
# Certificate Profile Signer") on the Artifact Signing account.
# In GitHub Actions, prefer OIDC federated credentials and omit the secret.
AZURE_TENANT_ID="00000000-0000-0000-0000-000000000000"
AZURE_CLIENT_ID="00000000-0000-0000-0000-000000000000"
AZURE_CLIENT_SECRET="change-me"   # omit when using OIDC federated credentials
# The publisher shown to users comes from your approved identity validation
# (your validated legal name), not from here. There is no .pfx/thumbprint.

# Alternative only if you ever switch away from Trusted Signing (file-based OV):
# WINDOWS_PFX_PASSWORD="change-me"
# WINDOWS_CERT_THUMBPRINT="..."
# WINDOWS_TIMESTAMP_URL="http://timestamp.digicert.com"
