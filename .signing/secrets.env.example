# Copy to `.signing/secrets.env` and fill in. NEVER commit the filled-in file
# (it is gitignored). These are also the values that become GitHub Actions
# secrets for the release workflow (Sprint B6 / DC28). Placeholders only here.

# ─── macOS: Developer ID signing + notarization ───────────────────────────────
# Your Apple Developer Team ID (10 chars).
APPLE_TEAM_ID="XXXXXXXXXX"
# Exact signing identity string from the certificate.
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (XXXXXXXXXX)"
# Password used when you exported macos/developer_id_application.p12.
APPLE_CERTIFICATE_PASSWORD="change-me"
# App Store Connect API key for notarization (preferred over Apple ID/password).
APPLE_API_KEY_ID="XXXXXXXXXX"
APPLE_API_ISSUER_ID="00000000-0000-0000-0000-000000000000"
# Path to the .p8 (kept in .signing/macos/). Used locally; in CI the key is a secret.
APPLE_API_KEY_PATH=".signing/macos/AuthKey_XXXXXXXXXX.p8"

# For CI, Tauri reads the certificate as base64. Generate with:
#   base64 -i .signing/macos/developer_id_application.p12 | pbcopy   (macOS)
#   base64 -w0 .signing/macos/developer_id_application.p12           (Linux)
# then store the output as the GitHub secret APPLE_CERTIFICATE (do NOT put it here).

# ─── Windows: Authenticode ───────────────────────────────────────────────────
# Method: "pfx" (file-based OV) or "cloud" (EV / Azure Trusted Signing / DigiCert).
WINDOWS_CERT_METHOD="pfx"
# For pfx: password used when exporting windows/authenticode.pfx, and the cert thumbprint.
WINDOWS_PFX_PASSWORD="change-me"
WINDOWS_CERT_THUMBPRINT="0000000000000000000000000000000000000000"
# Timestamp server (RFC 3161) used at signing time.
WINDOWS_TIMESTAMP_URL="http://timestamp.digicert.com"
# For cloud/EV signing, record the service account references instead of a pfx, e.g.:
# AZURE_TENANT_ID=""
# AZURE_CLIENT_ID=""
# AZURE_CLIENT_SECRET=""
# AZURE_TRUSTED_SIGNING_ACCOUNT=""
# AZURE_TRUSTED_SIGNING_PROFILE=""
