{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Synaplan Desktop",
  "version": "0.1.0",
  "identifier": "com.synaplan.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Synaplan Desktop",
        "width": 920,
        "height": 700,
        "minWidth": 560,
        "minHeight": 460,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Pair a computer with Synaplan and run skills locally.",
    "longDescription": "Synaplan Desktop pairs a computer with your Synaplan workspace, lets you chat with your Synaplan account, and runs installed Agent Skills locally under a filesystem allowlist.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
